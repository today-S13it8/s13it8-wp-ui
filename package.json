{
  "name": "@s13it8/wp-ui",
  "version": "0.1.0",
  "description": "Shared React design system for the WP Smith theme and plugins: Tailwind CSS, shadcn/ui, clsx + tailwind-merge + cva, Lucide, Typography, the PHP-to-React bridge, and the checks.",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "repository": "github:today-S13it8/s13it8-wp-ui",
  "bin": {
    "wp-ui": "bin/wp-ui.mjs"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./boot": "./src/boot.tsx",
    "./scope-css": {
      "types": "./dist/scope-css.d.ts",
      "default": "./dist/scope-css.js"
    },
    "./styles/base.css": "./src/styles/base.css",
    "./lib/*": "./src/lib/*.ts",
    "./ui/*": "./src/components/ui/*.tsx"
  },
  "files": [
    "src",
    "dist",
    "php",
    "bin",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "tsc -p tsconfig.node.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "postcss": "^8.5.33",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "puppeteer-core": ">=24"
  },
  "peerDependenciesMeta": {
    "puppeteer-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
